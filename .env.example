# Azure Entra ID (Azure AD) Configuration
AZURE_TENANT_ID="your_azure_tenant_id_here"
AZURE_CLIENT_ID="your_azure_client_id_here"
AZURE_CLIENT_SECRET="your_azure_client_secret_here"

# Bot Server Configuration
BOT_BASE_URL=https://teamsbot.prospectplus.com.au
BOT_NOTIFICATION_AUDIO_PATH=config/recording_announcement.wav
BOT_RECORDING_ANNOUNCEMENT_TEXT="This meeting is being recorded and transcribed for team notes."

# Transcription Engine Configuration (Options: "WhisperLocal", "AzureSpeech", "OpenAI")
TRANSCRIPTION_ENGINE=WhisperLocal
WHISPER_MODEL_SIZE=small
AZURE_SPEECH_KEY=your_azure_speech_key_if_used
AZURE_SPEECH_REGION=australiaeast

# Default Storage Settings (Can be overridden per meeting in UI)
DEFAULT_SAVE_FOLDER=~/Documents/MeetingTranscripts
