{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Graph.Communications": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "mailplus.com.au",
    "TenantId": "YOUR_AZURE_TENANT_ID",
    "ClientId": "YOUR_AZURE_CLIENT_ID",
    "ClientSecret": "YOUR_AZURE_CLIENT_SECRET"
  },
  "Bot": {
    "BotBaseUrl": "https://sqcvzh7n-5001.aue01.devtunnels.ms",
    "SignalingRoute": "/api/calls",
    "NotificationAudioPath": "config/recording_announcement.wav",
    "RecordingAnnouncement": "This meeting is being recorded and transcribed for team notes."
  },
  "Transcription": {
    "Engine": "WhisperLocal",
    "Whisper": {
      "ModelSize": "small",
      "Language": "en"
    },
    "AzureSpeech": {
      "SubscriptionKey": "",
      "Region": "australiaeast"
    }
  },
  "Storage": {
    "DefaultFolder": "~/Documents/MeetingTranscripts",
    "ExportFormats": ["docx", "srt", "json", "txt"]
  },
  "Smtp": {
    "FromEmail": "ankith.ravindran@mailplus.com.au"
  }
}
